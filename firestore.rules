rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Giriş yapmış herhangi biri (anonim ziyaretçi dahil)
    function isSignedIn() {
      return request.auth != null;
    }
    // Yönetici tarafından onaylanmış personel.
    // Kendi kendine kayıt olanlar (createdBy == "self-signup") ayrıca e-posta adreslerini doğrulamış olmalıdır;
    // yöneticinin panelden eklediği hesaplar bu şarttan muaftır.
    function isApprovedNonAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departments.size() > 0) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('createdBy', '') != 'self-signup' ||
         request.auth.token.email_verified == true);
    }
    // Yönetici (DEĞİŞMEDİ)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "abdullah.baydogan@eroglums.com";
    }

    match /ems_csr/{docId} {
      // Ziyaretçi SADECE ziyaretçi sayfalarının kullandığı 4 belgeyi okuyabilir (site bilgilendirmesi ziyaretçiye kapalı).
      // Bu liste sitedeki VISITOR_PUBLIC_DOCS listesiyle AYNI olmalıdır.
      allow read: if isAdmin() || isApprovedNonAdmin()
        || (isSignedIn() && docId in ['aboutCardPhotos', 'certificates', 'companyProfile', 'qualityHandbooks']);
      // Personel kayıt ekler/günceller; ama yalnız yöneticinin düzenlediği belgelere yazamaz ve hiçbir belgeyi silemez.
      allow create, update: if isAdmin()
        || (isApprovedNonAdmin()
            && !(docId in ['siteAnnouncement', 'aboutCardPhotos', 'prodManualOverrides'])
            && !docId.matches('(dailyAuditArchive|departmentAuditArchive)_.*'));
      allow delete: if isAdmin();
    }

    match /ems_csr_files/{document} {
      // Ziyaretçi SADECE hakkımızda fotoğraflarını, sertifika, şirket profili
      // ve kalite el kitabı dosyalarını okuyabilir.
      allow read: if isAdmin() || isApprovedNonAdmin()
        || (isSignedIn() && document.matches('(aboutCard_photo|cert_(thumb|pdf|officefile)|company_(thumb|pdf|officefile|video)|quality_(thumb|pdf|officefile|video))_.*'));
      // Personel fotoğraf/belge yükler; yönetici dosyalarına (ekip, müşteri logosu, departman/üretim fotoğrafı,
      // hakkımızda) yazamaz. Kullanıcı fotoğrafını yalnız kişinin kendisi yükler. Personel dosya SİLEMEZ
      // (yalnız kendi kullanıcı fotoğrafının eski parçaları hariç) — fotoğraflar bulutta da korunur.
      allow create, update: if isAdmin()
        || (isApprovedNonAdmin()
            && !document.matches('(team_member|customerlogo|maindeptphoto|prodCategory|aboutCard)_.*')
            && (!document.matches('useravatar_.*') || document.matches('useravatar_thumb_' + request.auth.uid + '_.*')));
      allow delete: if isAdmin()
        || (isApprovedNonAdmin() && document.matches('useravatar_thumb_' + request.auth.uid + '_.*'));
    }

    match /ems_csr_snapshots/{document=**} {
      // Günlük yedekler: ziyaretçi okuyamaz
      allow read: if isAdmin() || isApprovedNonAdmin();
      allow write: if isAdmin();
    }

    match /ems_private/{document=**} {
      // Gelir & Gider: yalnızca yönetici okuyup yazabilir
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow get: if request.auth != null &&
                    (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.departments.size() == 0
        && request.resource.data.createdBy == 'self-signup'
        && request.auth.token.email.matches('.*@eroglums[.]com$');
      // Kullanıcı yalnız kendi "şifre değiştirme zorunlu" işaretini kapatabilir (zorunlu şifre değişikliğinden sonra).
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
      allow delete: if isAdmin();
    }
  }
}
